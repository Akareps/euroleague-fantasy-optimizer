# Copy to .env and fill in. Nothing here is required for --offline mode.

# The Odds API (https://the-odds-api.com) - moneylines, spreads, totals, some player props.
ODDS_API_KEY=

# Optional: a second odds source. Any provider that returns decimal or American prices
# can be wired in through elfantasy/data/odds.py.
ODDS_API_BASE=https://api.the-odds-api.com/v4

# EuroLeague public feeds. Defaults are baked in; override if the upstream path moves.
EUROLEAGUE_API_BASE=https://api-live.euroleague.net
EUROLEAGUE_FEEDS_BASE=https://feeds.incrowdsports.com/provider/euroleague-feeds

# Season code, e.g. E2025 for the 2025-26 EuroLeague season.
EL_SEASON=E2025

# Where the local SQLite store and HTTP cache live.
ELFANTASY_DATA_DIR=./data
